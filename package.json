                    "leetcode.enableStatusBar": {
                        "type": "boolean",
                        "default": true,
                        "scope": "application",
                        "description": "在状态栏显示当前登录的 LeetCode 账号。"
                    },
                    "leetcode.editor.shortcuts": {
                        "type": "array",
                        "default": [
                            "submit",
                            "test"
                        ],
                        "scope": "window",
                        "items": {
                            "type": "string",
                            "enum": [
                                "submit",
                                "test",
                                "star",
                                "solution",
                                "description"
                            ],
                            "enumDescriptions": [
                                "提交代码并在 VS Code 内查看判题结果。",
                                "使用默认或自定义用例运行测试。",
                                "收藏或取消收藏当前题目。",
                                "查看当前题目的高赞题解。",
                                "查看题目描述。"
                            ]
                        },
                        "description": "题解代码中的快捷操作。"
                    },
                    "leetcode.enableSideMode": {
                        "type": "boolean",
                        "default": true,
                        "scope": "application",
                        "description": "做题时将题目、题解和判题结果统一显示在右侧编辑器组。"
                    },
                    "leetcode.nodePath": {
                        "type": "string",
                        "default": "node",
                        "scope": "application",
                        "description": "Node.js 可执行文件路径，例如 C:\\Program Files\\nodejs\\node.exe。"
                    },
                    "leetcode.colorizeProblems": {
                        "type": "boolean",
                        "default": true,
                        "scope": "application",
                        "description": "在题目列表中显示难度徽标和颜色。"
                    },
                    "leetcode.problems.sortStrategy": {
                        "type": "string",
                        "default": "None",
                        "scope": "application",
                        "enum": [
                            "None",
                            "Acceptance Rate (Ascending)",
                            "Acceptance Rate (Descending)"
                        ],
                        "description": "题目列表的排序方式。",
                        "enumDescriptions": [
                            "保持默认顺序",
                            "按通过率升序",
                            "按通过率降序"
                        ]
                    },
                    "leetcode.allowReportData": {
                        "type": "boolean",
                        "default": true,
                        "scope": "application",
                        "description": "允许 LeetCode 上报匿名使用数据以改进产品。"
                    },
                    "leetcode.studyPlanFiles": {
                        "type": "array",
                        "items": {
                            "type": "string",
                            "minLength": 1
                        },
                        "default": [
                            ".vscode/leetcode-study-plans.json"
                        ],
                        "scope": "window",
                        "description": "题单 JSON 文件，包含默认分类与自定义题单，侧边栏按 plans 数组顺序显示。相对路径从工作区根目录解析，支持 ${workspaceFolder}；题单内路径相对 JSON 所在目录。保存后自动刷新。空数组禁用配置并恢复原默认分类。"
                    }
                }
            }
        ],
        "jsonValidation": [
            {
                "fileMatch": "**/leetcode-study-plans.json",
                "url": "./resources/study-plans.schema.json"
            }
        ]
    },
