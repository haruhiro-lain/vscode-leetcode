{
    "name": "leetcode-cn",
    "displayName": "LeetCode-CN",
    "description": "在 VS Code 中浏览力扣题目、编写题解、运行测试、提交代码并查看中文判题结果。",
    "version": "0.22.9",
    "author": "haruhiro-lain",
    "publisher": "haruhiro-lain",
    "license": "MIT",
    "icon": "resources/LeetCode.png",
    "engines": {
        "vscode": "^1.57.0"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/haruhiro-lain/vscode-leetcode"
    },
    "homepage": "https://github.com/haruhiro-lain/vscode-leetcode/blob/feat/personalization/PERSONALIZATION.md",
    "categories": [
        "Other",
        "Snippets"
    ],
    "keywords": [
        "leetcode",
        "algorithm",
        "interview"
    ],
    "preview": true,
    "activationEvents": [
        "onUri",
        "onStartupFinished",
        "onCommand:leetcode.toggleLeetCodeCn",
        "onCommand:leetcode.signin",
        "onCommand:leetcode.signout",
        "onCommand:leetcode.manageSessions",
        "onCommand:leetcode.refreshExplorer",
        "onCommand:leetcode.pickOne",
        "onCommand:leetcode.showProblem",
        "onCommand:leetcode.previewProblem",
        "onCommand:leetcode.searchProblem",
        "onCommand:leetcode.testSolution",
        "onCommand:leetcode.submitSolution",
        "onCommand:leetcode.switchDefaultLanguage",
        "onCommand:leetcode.problems.sort",
        "onView:leetCodeExplorer",
        "onCommand:leetcode.editStudyPlans",
        "onCommand:leetcode.previewLocalMarkdown",
        "onCommand:leetcode.openLocalMarkdown",
        "onCommand:leetcode.startLocalProblem"
    ],
    "main": "./out/src/extension",
    "contributes": {
        "commands": [
            {
                "command": "leetcode.deleteCache",
                "title": "清理缓存",
                "category": "LeetCode-CN"
            },
            {
                "command": "leetcode.toggleLeetCodeCn",
                "title": "切换站点",
                "category": "LeetCode-CN",
                "icon": "$(globe)"
            },
            {
                "command": "leetcode.signin",
                "title": "登录",
                "category": "LeetCode-CN",
                "icon": "$(sign-in)"
            },
            {
                "command": "leetcode.signout",
                "title": "退出登录",
                "category": "LeetCode-CN"
            },
            {
                "command": "leetcode.manageSessions",
                "title": "管理刷题会话",
                "category": "LeetCode-CN"
            },
            {
                "command": "leetcode.refreshExplorer",
                "title": "刷新题目",
                "category": "LeetCode-CN",
                "icon": "$(refresh)"
            },
            {
                "command": "leetcode.pickOne",
                "title": "随机一题",
                "category": "LeetCode-CN",
                "icon": {
                    "light": "resources/light/shuffle.svg",
                    "dark": "resources/dark/shuffle.svg"
                }
            },
            {
                "command": "leetcode.showProblem",
                "title": "开始做题",
                "category": "LeetCode-CN"
            },
            {
                "command": "leetcode.previewProblem",
                "title": "预览题目",
                "category": "LeetCode-CN"
            },
            {
                "command": "leetcode.searchProblem",
                "title": "搜索题目",
                "category": "LeetCode-CN",
                "icon": "$(search)"
            },
            {
                "command": "leetcode.showSolution",
                "title": "查看高赞题解",
                "category": "LeetCode-CN"
            },
            {
                "command": "leetcode.testSolution",
                "title": "运行测试",
                "category": "LeetCode-CN"
            },
            {
                "command": "leetcode.submitSolution",
                "title": "提交代码",
                "category": "LeetCode-CN"
            },
            {
                "command": "leetcode.addFavorite",
                "title": "收藏题目",
                "category": "LeetCode-CN",
                "icon": {
                    "light": "resources/light/like.png",
                    "dark": "resources/dark/like.png"
                }
            },
            {
                "command": "leetcode.removeFavorite",
                "title": "取消收藏",
                "category": "LeetCode-CN",
                "icon": {
                    "light": "resources/light/dislike.png",
                    "dark": "resources/dark/dislike.png"
                }
            },
            {
                "command": "leetcode.switchDefaultLanguage",
                "title": "切换默认编程语言",
                "category": "LeetCode-CN"
            },
            {
                "command": "leetcode.problems.sort",
                "title": "题目排序",
                "category": "LeetCode-CN",
                "icon": "$(sort-precedence)"
            },
            {
                "command": "leetcode.editStudyPlans",
                "title": "自定义题单",
                "category": "LeetCode-CN",
                "icon": "$(new-file)"
            },
            {
                "command": "leetcode.previewLocalMarkdown",
                "title": "预览本地题目",
                "category": "LeetCode-CN",
                "icon": "$(preview)"
            },
            {
                "command": "leetcode.openLocalMarkdown",
                "title": "打开题目源文件",
                "category": "LeetCode-CN"
            },
            {
                "command": "leetcode.startLocalProblem",
                "title": "开始做题",
                "category": "LeetCode-CN",
                "icon": "$(code)"
            }
        ],
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "leetcode",
                    "title": "LeetCode-CN",
                    "icon": "resources/LeetCode.svg"
                }
            ]
        },
        "views": {
            "leetcode": [
                {
                    "id": "leetCodeExplorer",
                    "name": "LeetCode-CN"
                }
            ]
        },
        "menus": {
            "view/title": [
                {
                    "command": "leetcode.toggleLeetCodeCn",
                    "when": "view == leetCodeExplorer",
                    "group": "overflow@2"
                },
                {
                    "command": "leetcode.signin",
                    "when": "view == leetCodeExplorer && !leetcode.signedIn",
                    "group": "overflow@0"
                },
                {
                    "command": "leetcode.searchProblem",
                    "when": "view == leetCodeExplorer",
                    "group": "navigation@1"
                },
                {
                    "command": "leetcode.refreshExplorer",
                    "when": "view == leetCodeExplorer",
                    "group": "navigation@3"
                },
                {
                    "command": "leetcode.signout",
                    "when": "view == leetCodeExplorer && leetcode.signedIn",
                    "group": "overflow@1"
                },
                {
                    "command": "leetcode.pickOne",
                    "when": "view == leetCodeExplorer",
                    "group": "navigation@2"
                },
                {
                    "command": "leetcode.problems.sort",
                    "when": "view == leetCodeExplorer",
                    "group": "overflow@3"
                },
                {
                    "command": "leetcode.editStudyPlans",
                    "when": "view == leetCodeExplorer",
                    "group": "navigation@4"
                }
            ],
            "view/item/context": [
                {
                    "command": "leetcode.previewProblem",
                    "when": "view == leetCodeExplorer && viewItem =~ /problem*/",
                    "group": "leetcode@1"
                },
                {
                    "command": "leetcode.showProblem",
                    "when": "view == leetCodeExplorer && viewItem =~ /problem*/",
                    "group": "leetcode@2"
                },
                {
                    "command": "leetcode.showSolution",
                    "when": "view == leetCodeExplorer && viewItem =~ /problem*/",
                    "group": "leetcode@3"
                },
                {
                    "command": "leetcode.addFavorite",
                    "when": "view == leetCodeExplorer && viewItem == problem",
                    "group": "inline"
                },
                {
                    "command": "leetcode.removeFavorite",
                    "when": "view == leetCodeExplorer && viewItem == problem-favorite",
                    "group": "inline"
                },
                {
                    "command": "leetcode.previewLocalMarkdown",
                    "when": "view == leetCodeExplorer && viewItem =~ /^local-markdown/",
                    "group": "inline"
                },
                {
                    "command": "leetcode.openLocalMarkdown",
                    "when": "view == leetCodeExplorer && viewItem =~ /^local-markdown/",
                    "group": "leetcode@1"
                },
                {
                    "command": "leetcode.startLocalProblem",
                    "when": "view == leetCodeExplorer && viewItem == local-markdown-java",
                    "group": "inline@2"
                }
            ],
            "commandPalette": [
                {
                    "command": "leetcode.showProblem",
                    "when": "never"
                },
                {
                    "command": "leetcode.showSolution",
                    "when": "never"
                },
                {
                    "command": "leetcode.previewProblem",
                    "when": "never"
                },
                {
                    "command": "leetcode.addFavorite",
                    "when": "never"
                },
                {
                    "command": "leetcode.removeFavorite",
                    "when": "never"
                },
                {
                    "command": "leetcode.openLocalMarkdown",
                    "when": "never"
                },
                {
                    "command": "leetcode.signin",
                    "when": "!leetcode.signedIn"
                },
                {
                    "command": "leetcode.signout",
                    "when": "leetcode.signedIn"
                },
                {
                    "command": "leetcode.startLocalProblem",
                    "when": "never"
                }
            ],
            "explorer/context": [
                {
                    "command": "leetcode.testSolution",
                    "when": "explorerResourceIsFolder == false",
                    "group": "leetcode@1"
                },
                {
                    "command": "leetcode.submitSolution",
                    "when": "explorerResourceIsFolder == false",
                    "group": "leetcode@2"
                },
                {
                    "command": "leetcode.previewLocalMarkdown",
                    "when": "explorerResourceIsFolder == false && resourceExtname == .md",
                    "group": "leetcode@0"
                }
            ],
            "editor/context": [
                {
                    "submenu": "leetcode.editorAction"
                }
            ],
            "leetcode.editorAction": [
                {
                    "command": "leetcode.testSolution",
                    "group": "leetcode@1"
                },
                {
                    "command": "leetcode.submitSolution",
                    "group": "leetcode@2"
                },
                {
                    "command": "leetcode.showSolution",
                    "group": "leetcode@3"
                },
                {
                    "command": "leetcode.previewProblem",
                    "group": "leetcode@4"
                },
                {
                    "command": "leetcode.previewLocalMarkdown",
                    "when": "resourceExtname == .md",
                    "group": "leetcode@0"
                }
            ]
        },
        "submenus": [
            {
                "id": "leetcode.editorAction",
                "label": "LeetCode-CN"
            }
        ],
        "configuration": [
            {
                "title": "LeetCode-CN",
                "properties": {
                    "leetcode.hideSolved": {
                        "type": "boolean",
                        "default": false,
                        "scope": "application",
                        "description": "隐藏已通过的题目。"
                    },
                    "leetcode.defaultLanguage": {
                        "type": "string",
                        "enum": [
                            "bash",
                            "c",
                            "cpp",
                            "csharp",
                            "golang",
                            "java",
                            "javascript",
                            "kotlin",
                            "mysql",
                            "php",
                            "python",
                            "python3",
                            "ruby",
                            "rust",
                            "scala",
                            "swift",
                            "typescript"
                        ],
                        "scope": "window",
                        "description": "刷题时默认使用的编程语言。"
                    },
                    "leetcode.showDescription": {
                        "type": "string",
                        "default": "In Webview",
                        "enum": [
                            "In Webview",
                            "In File Comment",
                            "Both",
                            "None"
                        ],
                        "enumDescriptions": [
                            "在题目预览页面显示",
                            "在题解文件注释中显示",
                            "同时在预览页面和文件注释中显示",
                            "不显示题目描述"
                        ],
                        "scope": "application",
                        "description": "题目描述的显示位置。"
                    },
                    "leetcode.showCommentDescription": {
                        "type": "boolean",
                        "default": false,
                        "scope": "application",
                        "description": "【已弃用】在题解文件的注释中包含题目描述。",
                        "deprecationMessage": "请改用 leetcode.showDescription 设置题目描述的显示位置。"
                    },
                    "leetcode.hint.setDefaultLanguage": {
                        "type": "boolean",
                        "default": true,
                        "scope": "application",
                        "description": "提示设置默认编程语言。"
                    },
                    "leetcode.hint.configWebviewMarkdown": {
                        "type": "boolean",
                        "default": true,
                        "scope": "application",
                        "description": "提示通过 Markdown 设置调整题目和结果页面的外观。"
                    },
                    "leetcode.hint.commentDescription": {
                        "type": "boolean",
                        "default": true,
                        "scope": "application",
                        "description": "提示配置题解文件中的题目描述。"
                    },
                    "leetcode.hint.commandShortcut": {
                        "type": "boolean",
                        "default": true,
                        "scope": "application",
                        "description": "提示配置提交与测试的键盘快捷方式。"
                    },
                    "leetcode.useWsl": {
                        "type": "boolean",
                        "default": false,
                        "scope": "application",
                        "description": "使用 Windows 的 Linux 子系统（WSL）运行 LeetCode CLI。"
                    },
                    "leetcode.endpoint": {
                        "type": "string",
                        "default": "leetcode",
                        "scope": "application",
                        "enum": [
                            "leetcode",
                            "leetcode-cn"
                        ],
                        "description": "LeetCode 账号所使用的站点，中国站与国际站账号相互独立。",
                        "enumDescriptions": [
                            "LeetCode 国际站（leetcode.com）",
                            "力扣中国站（leetcode.cn）"
                        ]
                    },
                    "leetcode.cnConnectionMode": {
                        "type": "string",
                        "default": "direct",
                        "scope": "window",
                        "enum": [
                            "direct",
                            "proxy"
                        ],
                        "enumDescriptions": [
                            "中国站直连，避免代理出口触发网站验证；国际站继续使用原代理设置。",
                            "跟随 VS Code 的 http.proxy 和环境代理设置。"
                        ],
                        "description": "力扣中国站的连接方式，同时用于登录校验和 CLI 题目、测试、提交请求。"
                    },
                    "leetcode.useEndpointTranslation": {
                        "type": "boolean",
                        "default": true,
                        "scope": "application",
                        "description": "使用站点提供的题目翻译（中国站通常为中文）。"
                    },
                    "leetcode.workspaceFolder": {
                        "type": "string",
                        "scope": "window",
                        "description": "保存 LeetCode 题解文件的工作目录。支持相对于当前仓库的路径和 ${workspaceFolder} 变量。",
                        "default": ""
                    },
                    "leetcode.filePath": {
                        "type": "object",
                        "scope": "window",
                        "description": "题解文件相对于工作目录的子目录和文件名模板。",
                        "properties": {
                            "default": {
                                "type": "object",
                                "properties": {
                                    "folder": {
                                        "type": "string",
                                        "examples": [
                                            "src"
                                        ]
                                    },
                                    "filename": {
                                        "type": "string",
                                        "examples": [
                                            "${camelCaseName}.${ext}",
                                            "${PascalCaseName}.${ext}",
                                            "${id}-${kebab-case-name}.${ext}",
                                            "${id}_${snake_case_name}.${ext}"
                                        ]
                                    }
                                },
                                "required": [
                                    "folder",
