{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "LeetCode-CN 自定义题单",
    "type": "object",
    "required": ["version", "plans"],
    "additionalProperties": false,
    "properties": {
        "version": { "const": 1 },
        "plans": { "type": "array", "description": "侧边栏的完整题单及默认分类列表，按数组顺序显示。移除条目可隐藏它，空数组隐藏所有题单。", "items": { "$ref": "#/definitions/plan" } }
    },
    "definitions": {
        "plan": {
            "allOf": [
                { "$ref": "#/definitions/item" },
                { "required": ["id", "name"], "not": { "anyOf": [{ "required": ["file"] }, { "required": ["leetcode"] }] } }
            ]
        },
        "item": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "id": { "type": "string", "minLength": 1, "description": "题单的唯一标识，同一配置文件中不能重复。" },
                "name": { "type": "string", "minLength": 1, "description": "显示名称。分组必填；题目可省略。" },
                "builtin": { "type": "string", "enum": ["All", "Difficulty", "Tag", "Company", "Favorite"], "description": "默认分类：全部题目、难度、标签、公司或收藏。仅能放在 plans 顶层，原有分类与操作保持可用。" },
                "items": { "type": "array", "items": { "allOf": [{ "$ref": "#/definitions/item" }, { "not": { "required": ["builtin"] } }] } },
                "source": { "type": "string", "minLength": 1, "description": "Markdown 索引路径；按标题分组读取 .md 题目或带 @lc 标记的 Java 文件链接。" },
                "sourceMode": { "type": "string", "enum": ["links", "leetcode"], "default": "links", "description": "source 索引的链接范围：links 读取全文本地题目链接；leetcode 仅读取带 @lc 标记的 Java 力扣题解链接，忽略 Markdown 导航。" },
                "folder": { "type": "string", "minLength": 1, "description": "递归导入 .md 题目目录，子目录作为分组，忽略 README.md。" },
                "leetcode": { "oneOf": [{ "type": "string", "pattern": "^[0-9]+$" }, { "type": "integer", "minimum": 1 }], "description": "力扣数字题号。" },
                "file": { "type": "string", "minLength": 1, "description": "单个本地 .md 题目路径。" }
            },
            "oneOf": [
                { "required": ["name", "builtin"] },
                { "required": ["name", "items"] },
                { "required": ["name", "source"] },
                { "required": ["name", "folder"] },
                { "required": ["leetcode"] },
                { "required": ["file"] }
            ]
        }
    }
}
